{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "installCommand": "pip install -r GaX/requirements.txt",
  "functions": {
    "api/index.py": {
      "maxDuration": 60
    }
  },
  "rewrites": [
    { "source": "/(.*)", "destination": "/api/index" }
  ],
  "crons": [
    {
      "path": "/api/cron/check-payments",
      "schedule": "* * * * *"
    }
  ]
}
