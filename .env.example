# Application
ENV=development
DEBUG=True
LOG_LEVEL=INFO

# PostgreSQL (shared by FastAPI + Django)
DATABASE_URL=postgresql://gaxtron:gaxtron_secret@127.0.0.1:5433/gaxtron_db

# Redis (queues + rate limiting + idempotency)
REDIS_URL=redis://localhost:6379/0

# Security — CHANGE ALL BEFORE PRODUCTION (min 32 chars each)
SECRET_KEY=change-me-min-32-chars-for-jwt-signing-abc123
WEBHOOK_SECRET=change-me-min-32-chars-for-webhook-hmac-abc
WALLET_ENCRYPTION_KEY=change-me-32-byte-encryption-key-here!!

# ETH-only product (Sepolia) — set PUBLIC_BASE_URL to ngrok/Cloudflare HTTPS URL
ENABLED_CHAINS=ETH
PUBLIC_BASE_URL=http://127.0.0.1:8002

# Vercel Cron (generate: openssl rand -hex 32)
CRON_SECRET=
CHECKOUT_RECONCILE_ON_POLL=True

# Ethereum (ETH + ERC-20 USDT)
BLOCKCHAIN_RPC_URL=https://eth-sepolia.g.alchemy.com/v2/YOUR_KEY
BLOCKCHAIN_NETWORK=sepolia
ETH_REQUIRED_CONFIRMATIONS=3
REQUIRED_CONFIRMATIONS=3
BLOCKCHAIN_SCAN_BLOCKS=500
USDT_CONTRACT_ADDRESS=0x94a9D9AC8a22534D3cDfaD9d54e96e22d858e9b

# TRON (TRX + TRC-20 USDT)
TRON_NETWORK=shasta
TRON_API_URL=
TRON_USDT_CONTRACT=TG3XXyExBkPp9nzdajDZsozEu4BkaFjKHr
TRON_REQUIRED_CONFIRMATIONS=19

# Bitcoin
BITCOIN_API_URL=https://blockstream.info/testnet/api
BITCOIN_NETWORK=testnet
BTC_REQUIRED_CONFIRMATIONS=3

# Solana
SOLANA_RPC_URL=https://api.devnet.solana.com
SOL_REQUIRED_CONFIRMATIONS=32

# API limits
API_RATE_LIMIT=100
API_RATE_LIMIT_WINDOW=60
AUTH_RATE_LIMIT=20
AUTH_RATE_LIMIT_WINDOW=300
PAYMENT_EXPIRY_MINUTES=60
MAX_API_KEYS_PER_USER=10
WEBHOOK_MAX_ATTEMPTS=5
WEBHOOK_RETRY_BASE_SECONDS=30

# Production-only
REQUIRE_HTTPS_CALLBACKS=False
CORS_ORIGINS=http://localhost:8002,http://127.0.0.1:8002,http://localhost:8001,http://127.0.0.1:8001
API_ALLOWED_HOSTS=localhost,127.0.0.1,api

# Django
DJANGO_SECRET_KEY=change-me-django-secret-key-min-50-chars-long-please
ALLOWED_HOSTS=localhost,127.0.0.1
FASTAPI_URL=http://127.0.0.1:8002

# --- Full local stack (PowerShell) ---
# .\scripts\install_prerequisites.ps1
# .\scripts\start_full_stack.ps1

# --- Docker (all services) ---
# docker compose up -d postgres redis migrate api worker dashboard

# Production deployment:
# ENV=production
# DEBUG=False
# REQUIRE_HTTPS_CALLBACKS=True
# docker compose --profile production up -d api-prod worker postgres redis dashboard
