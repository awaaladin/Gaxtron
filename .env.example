# ============================================================================
# GAXTRON (Blockchain Wallet) - Environment Configuration
# ============================================================================

# Application Settings
ENV=development
DEBUG=True

# Database (PostgreSQL)
DATABASE_URL=postgresql://user:password@localhost:5432/gaxtron_db

# ============================================================================
# INTER-SERVICE COMMUNICATION
# ============================================================================

# Shared Security Keys (MUST match across all services)
SHARED_SERVICE_SECRET=your-shared-service-secret-key-min-32-chars-change-this
SHARED_JWT_SECRET=your-shared-jwt-secret-key-min-32-chars-change-this
WEBHOOK_SECRET=your-webhook-hmac-secret-key-min-32-chars-change-this

# Service URLs - Local Development
CREATE_API_URL=http://localhost:8000
GAX_API_URL=http://localhost:8001
TRINITY_API_URL=http://localhost:8002

# Service URLs - Production
# CREATE_API_URL=https://elibrary.yoursite.com
# GAX_API_URL=https://gax.yoursite.com
# TRINITY_API_URL=https://escrow.yoursite.com

# ============================================================================
# BLOCKCHAIN SETTINGS
# ============================================================================

# C++ Blockchain Configuration
BLOCKCHAIN_LIB_PATH=./GaX/gax_blockchain.so
BLOCKCHAIN_DIFFICULTY=4
BLOCKCHAIN_MINING_REWARD=50.0

# Blockchain node settings
BLOCKCHAIN_NODE_URL=http://localhost:8545
BLOCKCHAIN_NETWORK=testnet  # testnet or mainnet

# Wallet generation
DEFAULT_KEY_ALGORITHM=secp256k1
WALLET_ENCRYPTION_ENABLED=True

# ============================================================================
# TOKEN SETTINGS
# ============================================================================

# GAX Token Configuration
TOKEN_NAME=GAX
TOKEN_SYMBOL=GAX
TOKEN_DECIMALS=8
INITIAL_SUPPLY=21000000  # Similar to Bitcoin

# Token economics
BLOCK_REWARD=50.0
HALVING_INTERVAL=210000  # Blocks until reward halves

# ============================================================================
# MINING SETTINGS
# ============================================================================

MINING_ENABLED=True
MINER_ADDRESS=  # Will be auto-generated if empty
MINING_POOL_FEE=0.01  # 1%

# ============================================================================
# TRANSACTION SYNC
# ============================================================================

# Sync with GAX transaction system
SYNC_ENABLED=True
SYNC_INTERVAL_SECONDS=10
MAX_SYNC_RETRIES=5

# Transaction confirmation
REQUIRED_CONFIRMATIONS=6

# ============================================================================
# SECURITY
# ============================================================================

# Private key encryption
ENCRYPTION_KEY=your-encryption-key-for-private-keys-change-this
KEY_DERIVATION_ITERATIONS=100000

# ============================================================================
# API SETTINGS
# ============================================================================

API_RATE_LIMIT=100
API_TIMEOUT_SECONDS=30

# ============================================================================
# LOGGING
# ============================================================================

LOG_LEVEL=INFO
LOG_FILE=gaxtron.log
